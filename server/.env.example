# Copy this file to .env (gitignored) and set your own admin password.
# server/build.rs reads ADMIN_PASSWORD at compile time and bakes only its
# SHA-256 digest into the built module (see constants::ADMIN_PASSWORD_SHA256
# in src/lib.rs) — the plaintext is never committed or embedded anywhere.
ADMIN_PASSWORD=changeme

# Backup copy of the SpacetimeDB login that owns the published database,
# mirrored from ~/.config/spacetime/cli.toml. Nothing reads these at build
# or run time — they exist so the owner identity survives losing that file.
# Only the owner can republish, rename or delete a database; when the
# original `hexel` owner token was lost the name became unreclaimable
# without wiping the whole local control-db.
#   spacetime login --token "$HEXEL_OWNER_TOKEN"
HEXEL_OWNER_IDENTITY=c200...
HEXEL_OWNER_TOKEN=eyJ...
